# Example environment variables for PolicyLens.
# Copy this file to .env and fill in real values as needed. All variables
# below have working defaults (see backend/app/config.py) -- none are
# required for local development.

APP_ENV=development

# SQLite by default (zero external service dependency). Swap to a
# PostgreSQL URL later without any model code changes, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/policylens
# DATABASE_URL=sqlite:///backend/policylens_dev.db

# MAX_UPLOAD_SIZE_BYTES=20971520

# Comment text is never logged by default. Only set this to true for
# local debugging, and never in any shared/deployed environment.
# LOG_COMMENT_TEXT=false
